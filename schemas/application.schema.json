{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Application delivery descriptor v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "application",
    "releaseBranch",
    "chart",
    "chartName",
    "configCompatibility",
    "components",
    "policy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "application": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "releaseBranch": { "type": "string", "minLength": 1 },
    "chart": { "type": "string", "minLength": 1 },
    "chartName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "configCompatibility": { "type": "string", "minLength": 1 },
    "components": {
      "type": "object",
      "maxProperties": 256,
      "additionalProperties": {
        "type": "object",
        "required": ["compatibility", "workloads"],
        "properties": {
          "compatibility": { "type": "string", "minLength": 1 },
          "workloads": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "environment",
        "pipelineRepository",
        "trustedPipelineRevisions",
        "certification"
      ],
      "properties": {
        "environment": { "const": "delivery-release" },
        "pipelineRepository": { "type": "string" },
        "trustedPipelineRevisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
        },
        "certification": {
          "type": "object",
          "required": [
            "repository",
            "workflow",
            "revision",
            "predicateType",
            "policyVersion",
            "maxAgeHours",
            "decisionsPath"
          ],
          "properties": {
            "repository": { "type": "string" },
            "workflow": { "type": "string" },
            "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "predicateType": { "type": "string", "pattern": "^https://" },
            "policyVersion": { "type": "string", "minLength": 1 },
            "maxAgeHours": { "type": "integer", "minimum": 1, "maximum": 168 },
            "decisionsPath": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
